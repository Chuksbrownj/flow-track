# Neon PostgreSQL connection string (free tier)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Auth.js secret - generate with: openssl rand -base64 32
AUTH_SECRET=your-random-secret-here

# Initial admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@thrilled.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Administrator

# Public base URL used in password reset emails
APP_URL=https://your-app.vercel.app

# Brevo (free tier) - https://app.brevo.com/settings/keys/api (300 emails/day)
# Sender email must be verified in Brevo first
BREVO_API_KEY=xkeysib-your-api-key
BREVO_FROM_EMAIL=no-reply@yourdomain.com
BREVO_FROM_NAME=FlowTrack
